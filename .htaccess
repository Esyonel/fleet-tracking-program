Options -Indexes
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "same-origin"
Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
# Sayfa her acilista yeniden kontrol edilsin: eski sayfa eski app.js'i yuklemesin.
<FilesMatch "^(index\.html)?$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<FilesMatch "\.(md|json|db|sqlite|txt|example|log|ini)$">
Require all denied
</FilesMatch>
